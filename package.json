{
  "name": "vibe-coding",
  "version": "0.1.0",
  "private": true,
  "description": "Educational coding game with BMAD method and AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/vibe-coding.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:agents\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:agents": "cd agents && python -m uvicorn main:app --reload --port 8001",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "test": "npm run test:frontend && npm run test:backend && npm run test:agents",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:agents": "cd agents && pytest",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "setup": "npm run setup:frontend && npm run setup:backend && npm run setup:agents",
    "setup:frontend": "cd frontend && npm install",
    "setup:backend": "cd backend && npm install",
    "setup:agents": "cd agents && pip install -r requirements.txt"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "education",
    "coding",
    "game",
    "BMAD",
    "AI",
    "learning"
  ],
  "author": "Vibe Coding Team",
  "license": "MIT"
}
